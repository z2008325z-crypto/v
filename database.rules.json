{
  "rules": {
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.email === 'abmen@gmail.com'"
      }
    },
    "settings": {
      ".read": true,
      ".write": "root.child('admins/' + auth.uid).val() === true"
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins/' + auth.uid).val() === true)"
      }
    },
    "verified": {
      ".read": "auth != null",
      ".write": "root.child('admins/' + auth.uid).val() === true"
    },
    "posts": {
      ".read": "auth != null",
      "$postId": {
        ".validate": "!newData.exists() || (newData.hasChildren(['uid','text','createdAt']) && newData.child('text').val().length <= 500)",
        ".write": "auth != null && (!newData.exists() || newData.child('uid').val() === auth.uid) && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins/' + auth.uid).val() === true)"
      }
    },
    "likes": {
      ".read": "auth != null",
      "$postId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "tasks": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
    }
  }
}
